# Copy this file to .env and fill in your own Supabase project's values.
# Dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# The email of the one admin account you create in
# Dashboard → Authentication → Users → Add user.
# The admin login screen only asks for the password; this tells Supabase
# which account that password belongs to.
VITE_ADMIN_EMAIL=admin@mosdal.com
